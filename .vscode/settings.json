{
    // Map the ROS package name used in the URDF's "package://" mesh paths
    // to the workspace root so the STL meshes can be found.
    "urdf-visualizer.packages": {
        "sparky_description": "${workspaceFolder}/src/sparky_description"
    },
    // Treat .urdf files as XML for syntax highlighting.
    "files.associations": {
        "*.urdf": "xml",
        "*.xacro": "xml"
    },
    // Re-render the preview automatically whenever the URDF is saved.
    "urdf-visualizer.renderOnSave": true,
    // Initial preview state: show visual geometry, hide collision meshes.
    "urdf-visualizer.default.showVisual": true,
    "urdf-visualizer.default.showCollision": false
}
