<?xml version="1.0"?>
<package format="3">
  <name>sparky_description</name>
  <version>1.0.0</version>
  <description>URDF Description package for UWRobotics Sparky 2026 (exported from SolidWorks)</description>
  <author>UWRobotics Team</author>
  <maintainer email="uwaterloorobotics@gmail.com">UWRobotics Team</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- Gazebo Classic (used by launch/gazebo.launch.py) -->
  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
