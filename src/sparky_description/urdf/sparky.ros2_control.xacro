<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control hardware description for the Sparky CIRC 2026 rover.
  -->
  <xacro:macro name="sparky_ros2_control"
               params="name use_mock_hardware:=true can_interface:=can0">

    <ros2_control name="${name}" type="system">

      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
          <param name="can">${can_interface}</param>
        </hardware>
      </xacro:unless>

      <!-- Per-wheel joint definition. node_id is only used by the ODrive
           backend; mock_components ignores it. direction (+1/-1) is the sign the
           ODrive backend applies to commands and feedback: the left wheels are
           mirror-mounted, so they get -1 to spin the correct way for forward
           motion. mock_components ignores direction too. -->
      <xacro:macro name="drive_joint" params="name node_id direction:=1">
        <joint name="${name}">
          <param name="node_id">${node_id}</param>
          <param name="direction">${direction}</param>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <!-- Left side (mirror-mounted: inverted) -->
      <xacro:drive_joint name="Front_Left_Wheel_Joint"  node_id="4" direction="-1"/>
      <xacro:drive_joint name="Center_Left_Wheel_Joint" node_id="5" direction="-1"/>
      <xacro:drive_joint name="Rear_Left_Wheel_Joint"   node_id="6" direction="-1"/>

      <!-- Right side -->
      <xacro:drive_joint name="Front_Right_Wheel_Joint"  node_id="1"/>
      <xacro:drive_joint name="Center_Right_Wheel_Joint" node_id="2"/>
      <xacro:drive_joint name="Rear_Right_Wheel_Joint"   node_id="3"/>

    </ros2_control>

  </xacro:macro>

</robot>
