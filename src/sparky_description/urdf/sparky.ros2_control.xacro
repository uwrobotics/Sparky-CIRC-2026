<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    UWRobotics Sparky ros2_control package 
  -->
  <xacro:macro name="sparky_ros2_control" params="name use_mock_hardware can_interface">

    <ros2_control name="${name}" type="system">

      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
          <param name="can">${can_interface}</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="drive_joint" params="name node_id direction:=1 gear_ratio:=35">
        <joint name="${name}">
          <param name="node_id">${node_id}</param>
          <param name="direction">${direction}</param>
          <param name="gear_ratio">${gear_ratio}</param>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <!-- Left side (inverted) -->
      <xacro:drive_joint name="Front_Left_Wheel_Joint"  node_id="4"/>
      <xacro:drive_joint name="Center_Left_Wheel_Joint" node_id="5"/>
      <xacro:drive_joint name="Rear_Left_Wheel_Joint"   node_id="6"/>

      <!-- Right side -->
      <xacro:drive_joint name="Front_Right_Wheel_Joint"  node_id="1"/>
      <xacro:drive_joint name="Center_Right_Wheel_Joint" node_id="2"/>
      <xacro:drive_joint name="Rear_Right_Wheel_Joint"   node_id="3"/>

    </ros2_control>

  </xacro:macro>

</robot>
