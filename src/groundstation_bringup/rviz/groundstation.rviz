Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /AerialMap1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    # Satellite/OSM tiles under the rover, anchored on the VN-300 fix.
    # rviz_satellite positions the tile plane by looking up TF from the Fixed
    # Frame to the NavSatFix header's frame_id -- so the "vectornav" link in
    # sparky.sensors.xacro is a hard requirement, not decoration.
    #
    # It also validates every message: NO_FIX status or NaN lat/lon are dropped
    # with a red error and the tiles simply stop updating, so a dead GNSS can
    # never teleport the map to Null Island.
    #
    # Timeout is the fade-out: tiles start dimming at 1.5 s without a valid fix
    # and vanish at 3 s, which is the visual cue that GNSS dropped out. Set 0 to
    # disable fading and leave the last-known map on screen indefinitely.
    #
    # Object URI is the OSM public tile server -- fine for testing, but its
    # usage policy forbids bulk downloading, so keep Blocks small. Blocks is the
    # ring of tiles around the centre one, i.e. (2*B+1)^2 requests: 3 -> 49
    # tiles, which at Zoom 18 covers roughly 800 m of ground. Tiles cache to
    # ~/.cache/rviz_satellite and are never re-fetched, so pre-warm the cache by
    # panning over the competition site while you still have internet.
    - Alpha: 0.7
      Blocks: 3
      Class: rviz_satellite/AerialMap
      Draw Behind: true
      Enabled: true
      Name: AerialMap
      Object URI: https://tile.openstreetmap.org/{z}/{x}/{y}.png
      TF tolerance: 0.1
      Timeout: 3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vectornav/gnss
      Value: true
      Zoom: 18
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: VelocityArrow
      Namespaces:
        velocity: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sparky/velocity_marker
      Value: true
    # SIYI gimbal camera feed, decoded on the groundstation by
    # siyi_camera_launch.py. Reliability MUST stay Best Effort: siyi_camera_node
    # publishes BEST_EFFORT so DDS backpressure cannot stall the stream, and a
    # Reliable subscriber is simply incompatible -- RViz silently shows a blank
    # panel and logs "offering incompatible QoS. No messages will be sent to it."
    #
    # This is the raw topic on purpose. /siyi/image_compressed does not follow
    # the image_transport <base>/compressed convention, so RViz binds two message
    # types to that one name and cannot display it.
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: SiyiCamera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /siyi/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.4
      # Camera orbits and follows the rover body so it stays centered as it drives.
      Target Frame: base_link
      Yaw: 0.7
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  # Key must match the Image display's Name -- that is how RViz restores the
  # dock panel it renders the video into. Rename one and you must rename both.
  SiyiCamera:
    collapsed: false
  Width: 1200
