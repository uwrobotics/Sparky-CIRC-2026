<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>siyi_watchdog</name>
  <version>1.0.0</version>
  <description>
    Restarts siyi_camera_node when the SIYI RTSP stream stops delivering frames.
  </description>
  <author>UWRobotics Team</author>
  <maintainer email="uwaterloorobotics@gmail.com">UWRobotics Team</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
