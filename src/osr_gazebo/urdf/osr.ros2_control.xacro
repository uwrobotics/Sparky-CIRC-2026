<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Hardware interface for the Sparky CIRC 2026 rover using ODrive motor controllers.
    Each of the 6 drive joints maps to one ODrive axis via SocketCAN.

    CAN node ID assignment (matches drivetrain.yaml):
      Left  side — front: 1, middle: 3, rear: 5
      Right side — front: 2, middle: 4, rear: 6

    use_mock_hardware=true  → mock_components/GenericSystem (unit testing, no hardware)
    use_mock_hardware=false → odrive_ros2_control_plugin/ODriveHardwareInterface (real rover)
  -->
  <xacro:macro name="osr_ros2_control" params="name can_interface use_mock_hardware:=false">

    <ros2_control name="${name}" type="system">

      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
          <param name="can">${can_interface}</param>
        </hardware>
      </xacro:unless>

      <!-- Left drive wheels -->
      <joint name="front_wheel_joint_left">
        <param name="node_id">1</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="middle_wheel_joint_left">
        <param name="node_id">3</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="rear_wheel_joint_left">
        <param name="node_id">5</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Right drive wheels -->
      <joint name="front_wheel_joint_right">
        <param name="node_id">2</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="middle_wheel_joint_right">
        <param name="node_id">4</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="rear_wheel_joint_right">
        <param name="node_id">6</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
